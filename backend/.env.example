# Copy to backend/.env and adjust. Never commit the real .env file.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Origin of the frontend (used for CORS and CSRF origin checks).
APP_ORIGIN=http://localhost:5173

# Base URL encoded in every QR code: <PUBLIC_QR_BASE_URL>/qr/<token>. QR codes printed on
# shirts can never be changed, so in production use a domain you will keep permanently
# (required, must be https://). Defaults to APP_ORIGIN when unset outside production.
# PUBLIC_QR_BASE_URL=https://qrcare.example.vn

# Number of reverse proxies in front of the API (0 locally, usually 1 in production).
TRUST_PROXY=0

# PostgreSQL. The values below match docker-compose.yml (local development only).
# In production use a strong password and add ?sslmode=require if the provider needs TLS.
DATABASE_URL=postgres://qrcare:qrcare_dev_password@127.0.0.1:5432/qrcare
DATABASE_POOL_MAX=10

# Secret used to sign access tokens (HS256). At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production while this placeholder is still set.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Set true/false to override the default (Secure cookies only when NODE_ENV=production).
# COOKIE_SECURE=

# Where uploaded avatars are stored. "local" writes files under STORAGE_LOCAL_DIR
# (relative to the backend folder). Back this directory up together with the database.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage

# Used only by the automated tests. MUST point to a database whose name ends in "_test":
# the test suite deletes all data in it.
TEST_DATABASE_URL=postgres://qrcare:qrcare_dev_password@127.0.0.1:5432/qrcare_test
