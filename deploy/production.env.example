# Production configuration for deploy/compose.yml.
# Copy to deploy/production.env (git-ignored: it holds real secrets), replace every value
# under a "CHANGE" line, then start with:
#   docker compose --env-file deploy/production.env -f deploy/compose.yml up -d --build
# The server refuses to start if a required value is missing or unsafe (placeholder secret,
# console OTP delivery, non-https QR domain...). Full reference: docs/deployment.md.
#
# Generate each random value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (base64url output is safe inside the database URL, unlike passwords with @ : / characters.)

NODE_ENV=production
LOG_LEVEL=info

# CHANGE: the public address of the site (scheme + host, no path).
APP_ORIGIN=https://qrcare.example.vn

# CHANGE: printed inside every QR code on every shirt. Choose a domain you will keep forever.
PUBLIC_QR_BASE_URL=https://qrcare.example.vn

# Number of proxies in front of the app (nginx or the platform load balancer): usually 1.
TRUST_PROXY=1

# CHANGE: database password (used by both the database and the app containers).
POSTGRES_PASSWORD=CHANGE-generate-a-random-value

# CHANGE: signing key for sessions.
JWT_ACCESS_SECRET=CHANGE-generate-a-random-value-of-64-characters

# CHANGE: key for hashing one-time passwords (must differ from JWT_ACCESS_SECRET).
OTP_SECRET=CHANGE-generate-another-random-value-of-64-characters

# Password-recovery email through any SMTP service.
# Set EMAIL_PROVIDER=disabled until an SMTP account is available.
EMAIL_PROVIDER=smtp
# CHANGE: sender and SMTP account.
EMAIL_FROM=QR Care <no-reply@qrcare.example.vn>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# No SMS gateway has been chosen yet: recovery by phone answers "not available".
SMS_PROVIDER=disabled

# Set by the image; only change if you know why.
# STORAGE_LOCAL_DIR=/data/storage
# MIGRATE_ON_START=true
# DATABASE_POOL_MAX=10
